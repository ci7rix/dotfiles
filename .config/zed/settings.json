{
  "theme": {
    "mode": "system",
    "light": "Rosé Pine Dawn",
    "dark": "Rosé Pine"
  },
  "auto_install_extensions": {
    "rose-pine-theme": true
  },
  "ui_font_size": 14,
  "buffer_font_family": "Monaspace Neon Var",
  "buffer_font_size": 13,
  "project_panel": {
    "dock": "left"
  },
  "scroll_beyond_last_line": "off",
  "show_whitespaces": "all",
  "vim_mode": true,
  "cursor_blink": false,
  "tab_size": 2,
  "hard_tabs": false
}
