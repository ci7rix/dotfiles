#!/usr/bin/env bash
#MISE description="Test the config in a throwaway HOME: mise config, dotfile links, syntax of every file (installs nothing)"
#USAGE flag "-k --keep" help="Keep the temporary HOME for inspection"
#USAGE flag "-v --verbose" help="Show the output of passing checks too"
#
# Your real HOME is never touched. The temporary HOME has the same layout as
# after bootstrap.sh, with this working copy (uncommitted changes included).
set -uo pipefail
. "$(dirname "$0")/.lib.sh"

KEEP="${usage_keep:-false}"
VERBOSE="${usage_verbose:-false}"
PATH="$PATH:/Applications/Ghostty.app/Contents/MacOS"
command -v mise >/dev/null || die "mise not found"

# "~/Developer/github.com/ci7rix/dotfiles"
ROOT="$(sed -n 's/^dotfiles\.root *= *"\([^"]*\)".*/\1/p' "$MISE_CONFIG")"
[ -n "$ROOT" ] || die "dotfiles.root not found in $MISE_CONFIG"

SANDBOX="$(cd "$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-check.XXXXXX")" && pwd -P)"
LOGS="$SANDBOX/.check-logs"
mkdir -p "$LOGS" "$SANDBOX/tmp" "$SANDBOX/.config" "$(dirname "$SANDBOX/${ROOT#\~/}")"
ln -s "$REPO_ROOT" "$SANDBOX/${ROOT#\~/}"
ln -s "$REPO_ROOT/.config/mise" "$SANDBOX/.config/mise"

cleanup() {
  # rm removes the links, never what they point to
  if [ "$KEEP" = "true" ]; then echo "Sandbox kept: $SANDBOX"; else rm -rf "$SANDBOX"; fi
}
trap cleanup EXIT

# Run a command with HOME and the XDG folders inside the sandbox
in_sandbox() {
  (cd "$SANDBOX" && env -i \
    HOME="$SANDBOX" USER="${USER:-tester}" LOGNAME="${USER:-tester}" \
    PATH="$PATH" TERM="${TERM:-xterm-256color}" LANG=en_US.UTF-8 TMPDIR="$SANDBOX/tmp" \
    XDG_CONFIG_HOME="$SANDBOX/.config" XDG_DATA_HOME="$SANDBOX/.local/share" \
    XDG_CACHE_HOME="$SANDBOX/.cache" XDG_STATE_HOME="$SANDBOX/.local/state" \
    "$@")
}

# --- Test helpers ---------------------------------------------------------------
PASS=0 FAIL=0 SKIP=0
section() { printf '\n\033[1m%s\033[0m\n' "$1"; }
skip() { printf '  \033[33mSKIP\033[0m %s (%s)\n' "$1" "$2"; SKIP=$((SKIP + 1)); }

# check <label> <command...>
check() {
  local label="$1" log; shift
  log="$LOGS/$(printf '%s' "$label" | tr -c 'A-Za-z0-9' '-').log"
  if "$@" >"$log" 2>&1; then
    printf '  \033[32mPASS\033[0m %s\n' "$label"; PASS=$((PASS + 1))
    if [ "$VERBOSE" = "true" ]; then sed 's/^/       /' "$log"; fi
  else
    printf '  \033[31mFAIL\033[0m %s\n' "$label"; FAIL=$((FAIL + 1))
    tail -n 20 "$log" | sed 's/^/       /'
  fi
}

# needs <tool> <label> <command...>: check, or skip when the tool is not installed
needs() {
  local tool="$1"; shift
  if command -v "$tool" >/dev/null 2>&1; then check "$@"; else skip "$1" "$tool not installed"; fi
}

# --- mise -----------------------------------------------------------------------
section "mise"

same_root() {
  local dir
  dir="$(sed -n 's/^REPO_DIR="\$HOME\/\([^"]*\)".*/\1/p' "$REPO_ROOT/bootstrap.sh")"
  echo "mise.toml: $ROOT, bootstrap.sh: ~/$dir"
  [ "$ROOT" = "~/$dir" ]
}
check "dotfiles.root is where bootstrap.sh clones" same_root
check "mise loads the config"          in_sandbox mise config ls
check "mise bootstrap --dry-run"       in_sandbox mise bootstrap --dry-run
check "mise bootstrap --only dotfiles" in_sandbox mise bootstrap --only dotfiles --yes

section "Dotfiles linked"
while IFS= read -r t; do
  # -L too: a link to a tool that is not installed here still counts
  check "~/$t" bash -c '[ -e "$1" ] || [ -L "$1" ]' _ "$SANDBOX/$t"
done < <(dotfile_targets)

# --- Syntax ---------------------------------------------------------------------
section "Syntax"

nvim_syntax() {
  # loadfile() compiles init.lua without running it: no plugin is downloaded
  in_sandbox nvim --clean --headless \
    -c "lua local ok, err = loadfile([[$REPO_ROOT/.config/nvim/init.lua]]) if not ok then io.stderr:write(err .. '\\n') vim.cmd.cquit() end" \
    -c 'qa!'
}

starship_config() {
  local out
  out="$(in_sandbox env STARSHIP_CONFIG="$REPO_ROOT/.config/starship/starship.toml" starship print-config 2>&1 >/dev/null)"
  echo "$out"
  ! grep -qiE 'warn|error' <<<"$out"
}

for f in "$REPO_ROOT/bootstrap.sh" "$REPO_ROOT/mise-tasks/.lib.sh" "$REPO_ROOT"/mise-tasks/*; do
  check "bash: ${f#"$REPO_ROOT/"}" bash -n "$f"
done
needs fish     "fish: config.fish"         fish --no-config -n "$REPO_ROOT/.config/fish/config.fish"
# A standard TERM: the sandbox has no Ghostty terminfo, and only the file is under test
needs tmux     "tmux: tmux.conf"           in_sandbox env TERM=xterm-256color tmux -L "dotfiles-check-$$" -f /dev/null \
                                             start-server \; source-file -n "$REPO_ROOT/.config/tmux/tmux.conf"
needs nvim     "nvim: init.lua"            nvim_syntax
needs starship "starship: starship.toml"   starship_config
needs ghostty  "ghostty: config"           in_sandbox ghostty +validate-config
needs python3  "karabiner: karabiner.json" python3 -m json.tool "$REPO_ROOT/.config/karabiner/karabiner.json"
needs python3  "zed: settings.json" python3 -m json.tool "$REPO_ROOT/.config/zed/settings.json"

# --- Summary --------------------------------------------------------------------
printf '\n%d passed, %d failed, %d skipped\n' "$PASS" "$FAIL" "$SKIP"
if [ "$FAIL" -gt 0 ] && [ "$KEEP" != "true" ]; then
  echo "Run again with --keep to inspect the sandbox and its .check-logs/"
fi
[ "$FAIL" -eq 0 ]
